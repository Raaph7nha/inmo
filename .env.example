# Puerto del servidor Express
PORT=3000
NODE_ENV=development

# Origen permitido para CORS (en produccion usa tu dominio de Render/Vercel)
ALLOWED_ORIGIN=http://localhost:3000

# Cadena de conexion de Neon Postgres (obligatorio incluir sslmode=require)
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clave de API de Groq (solo en servidor, nunca en frontend)
GROQ_API_KEY=gsk_reemplaza_con_tu_clave_de_groq

# Modelo de Groq con soporte de tool use / function calling (ej: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
