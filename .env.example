# Puerto del servidor Express
PORT=3000
NODE_ENV=development

# Origen permitido para CORS (en produccion usa tu dominio de Render/Vercel)
ALLOWED_ORIGIN=http://localhost:3000

# Cadena de conexion de Neon Postgres (obligatorio incluir sslmode=require)
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clave de API de Groq (solo en servidor, nunca en frontend)
GROQ_API_KEY=gsk_reemplaza_con_tu_clave_de_groq
GROQ_MODEL=llama-3.3-70b-versatile

# Autenticación JWT
JWT_SECRET=super_secret_jwt_key_minimun_64_characters_long_random_string_here_1234567890
JWT_EXPIRES_IN=7d

# Credenciales de Cloudinary para subida firmada de imágenes
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
